FROM python:3.14-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN addgroup --system app && adduser --system --ingroup app app
COPY pyproject.toml poetry.lock ./
RUN pip install --no-cache-dir poetry && poetry config virtualenvs.create false && poetry install --only main --no-root
COPY apps/sesion8_bi_dashboard.py ./apps/sesion8_bi_dashboard.py
RUN chown -R app:app /app
USER app
EXPOSE 8080
CMD ["sh", "-c", "streamlit run apps/sesion8_bi_dashboard.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true"]
